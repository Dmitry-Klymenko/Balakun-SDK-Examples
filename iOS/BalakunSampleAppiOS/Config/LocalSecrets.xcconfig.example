// Copy this file to LocalSecrets.xcconfig and fill your tenant values.
// Do not commit LocalSecrets.xcconfig.
// Note: xcconfig treats `//` as comment. Keep URL format as `https:$(BALAKUN_SLASH)$(BALAKUN_SLASH)host`.

BALAKUN_TENANT_ID = demo
BALAKUN_PARENT_ORIGIN = https:$(BALAKUN_SLASH)$(BALAKUN_SLASH)mobile.example.com
BALAKUN_PARENT_PAGE_PATH = /app
BALAKUN_EMBED_TOKEN =
BALAKUN_LOG_RAW_SSE_EVENTS = NO
BALAKUN_LOG_ANALYTICS_SIGNALS = NO
